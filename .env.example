# Copy to .env and adjust for your machine. .env is git-ignored and must never be
# committed. Both Docker Compose and Django read this file.
#
# THIS FILE IS FOR LOCAL DEVELOPMENT. Every provider below defaults to a
# deterministic fake, so a fresh checkout runs and its tests pass with no
# external account anywhere. None of these values is a credential.
#
# Production is configured through the platform's own environment, never through
# a file in the image. See docs/deployment.md for the required set; the
# application refuses to start in production with any provider still set to a
# fake, with a missing credential for a provider it has selected, or with a
# development secret key.
#
# Docker Compose treats $ as variable interpolation when it reads this file, so a
# literal $ in any value must be written $$. Django's generated secret keys often
# contain one. Either escape it or generate a key without it, otherwise every
# compose command prints a "variable is not set" warning.

# --- Django ---------------------------------------------------------------
# Required everywhere. Production reads it without a fallback and refuses a value
# that is short or contains "insecure".
DJANGO_SECRET_KEY=generate-a-long-random-value-for-this
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO

# `console` is readable at a terminal; `json` is one object per line, which is
# what production uses. Every line carries the request id.
LOG_FORMAT=console

# Required in production, unused locally where dev settings accept any host so a
# phone can reach the machine by its LAN address.
# DJANGO_ALLOWED_HOSTS=api.sync.ng
# Needed for the admin behind HTTPS. The API uses bearer tokens and needs none.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.sync.ng
# Only for browser clients. A native app sends no Origin header.
# DJANGO_CORS_ALLOWED_ORIGINS=https://sync.ng

# --- PostgreSQL -----------------------------------------------------------
# The first three are consumed by Docker Compose when it creates the container.
# DATABASE_URL is what Django reads, and must agree with them.
POSTGRES_DB=sync
POSTGRES_USER=sync
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://sync:choose-a-local-password@127.0.0.1:5432/sync

# Production only. `require` encrypts without verifying the server certificate;
# `verify-full` also checks it and needs a root certificate on the host.
# DATABASE_SSLMODE=require
# How long a connection is reused. Zero locally, ten minutes in production.
# DATABASE_CONN_MAX_AGE=600

# --- Payments -------------------------------------------------------------
# Which gateway takes money from customers. The default moves nothing and
# reports every payment as pending, which is what you want locally: the whole
# payment flow works without a Paystack account, and nothing succeeds by
# accident.
#
#   apps.payments.gateways.fake.FakeGateway          local and test default
#   apps.payments.gateways.paystack.PaystackGateway  production
PAYMENT_GATEWAY=apps.payments.gateways.fake.FakeGateway

# Signs webhooks for the fake gateway so signature checking, replay and forgery
# refusal are all exercised locally. Not a production credential: with Paystack
# configured this is never read. Any string will do.
PAYMENT_GATEWAY_FAKE_SECRET=fake-gateway-signing-secret

# Paystack, from the dashboard at https://dashboard.paystack.com/#/settings/developers
# Required in production when PAYMENT_GATEWAY is the Paystack adapter. Leave
# both blank locally.
#
# The secret key signs API requests and verifies webhook signatures. It must
# never reach a client, appear in a log, or be committed. The public key is safe
# in a client and is here so one place describes the account.
#
# Set the webhook URL in the same dashboard to:
#   https://your-domain/api/v1/webhooks/paystack/
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Confirms a provider's bank account is real before money is sent to it.
# Paystack resolves account numbers, so the same credentials serve both.
#
#   apps.payments.banks.fake.FakeBankResolver          local and test default
#   apps.payments.banks.paystack.PaystackBankResolver  production
BANK_RESOLVER=apps.payments.banks.fake.FakeBankResolver

# --- SMS ------------------------------------------------------------------
# Everything Sync puts on somebody's phone goes through this provider: the
# verification codes, and the marketplace notifications that tell a provider a
# job is waiting. The default prints to the console and sends nothing, which is
# what you want locally.
#
# In production this is the difference between a marketplace and a database.
# A broadcast offer that only reaches a provider who happens to have the app
# open is not dispatch.
#
#   apps.accounts.sms.console.ConsoleSMSProvider   local default
#   apps.accounts.sms.termii.TermiiSMSProvider     production
SMS_BACKEND=apps.accounts.sms.console.ConsoleSMSProvider

# Termii, from https://accounts.termii.com. Required in production when
# SMS_BACKEND is the Termii adapter. TERMII_SENDER_ID must be a sender Termii
# has approved for the account: an unapproved one is the usual reason messages
# are accepted and never delivered.
TERMII_API_KEY=
TERMII_SENDER_ID=Sync
TERMII_CHANNEL=dnd

# --- Email ----------------------------------------------------------------
# Django's own email framework is the abstraction, and this setting selects the
# implementation. It carries verification emails and every booking, payment and
# payout notice. The default prints to the console and sends nothing.
#
#   django.core.mail.backends.console.EmailBackend   local default
#   apps.accounts.email.resend.ResendEmailBackend    production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sync <no-reply@sync.ng>

# Resend, from https://resend.com/api-keys. Required in production when
# EMAIL_BACKEND is the Resend backend. The sending domain must be verified at
# Resend first, and DEFAULT_FROM_EMAIL must be an address on it.
RESEND_API_KEY=

# --- Background work ------------------------------------------------------
# Celery over Redis. Two processes, both started deliberately and neither
# started by Django:
#
#   worker:    celery -A config worker --loglevel=info
#   scheduler: celery -A config beat --loglevel=info
#
# A worker runs the tasks; the scheduler is what puts the periodic ones on the
# queue. Exactly one scheduler should run. Several workers is fine and is
# tested: every task locks what it touches and is safe run twice.
#
# Both default to REDIS_URL, so a local machine needs neither line.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# How many tasks one worker runs at once, and when a stuck task is killed.
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360

# How much each sweep looks at per run. Whatever is left is picked up next time.
TASK_BATCH_SIZE=200

# How often the periodic work runs, in seconds. Conservative on purpose: two of
# these talk to Paystack, and a tight schedule against a rate-limited API is its
# own outage.
SCHEDULE_OFFER_EXPIRY_SECONDS=60
SCHEDULE_PAYMENT_RECONCILIATION_SECONDS=300
SCHEDULE_PAYOUT_RECONCILIATION_SECONDS=300
SCHEDULE_CHALLENGE_CLEANUP_SECONDS=3600
SCHEDULE_CONSISTENCY_SWEEP_SECONDS=3600

# When a payment is old enough to be worth asking the provider about, and when
# to stop asking and leave it for a person.
PAYMENT_PENDING_AFTER_SECONDS=900
PAYMENT_GIVE_UP_AFTER_SECONDS=604800

# How long a submitted transfer may sit unresolved before it is flagged for a
# person. The provider usually answers in seconds.
PAYOUT_STALE_AFTER_SECONDS=3600

# --- Payouts --------------------------------------------------------------
# Moves money out to providers. The fake submits nothing and reports every
# transfer as pending until a test says otherwise, which is what you want
# locally: the whole payout path works, including the recovery from a submission
# whose outcome was never received, and no naira moves.
#
#   apps.payments.transfers.fake.FakeTransferProvider          local and test
#   apps.payments.transfers.paystack.PaystackTransferProvider  production
#
# Paystack Transfers uses the same PAYSTACK_SECRET_KEY as payments, and needs
# transfers enabled on the account plus a funded balance. Production reads this
# without a fallback: a deployment with no transfer provider would leave every
# payout sitting in REQUESTED with nobody noticing.
PAYOUT_TRANSFER_PROVIDER=apps.payments.transfers.fake.FakeTransferProvider

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
