# Copy to .env and adjust for your machine. .env is git-ignored and must never be
# committed. Both Docker Compose and Django read this file.
#
# Docker Compose treats $ as variable interpolation when it reads this file, so a
# literal $ in any value must be written $$. Django's generated secret keys often
# contain one. Either escape it or generate a key without it, otherwise every
# compose command prints a "variable is not set" warning.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-long-random-value-for-this
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL -----------------------------------------------------------
# The first three are consumed by Docker Compose when it creates the container.
# DATABASE_URL is what Django reads, and must agree with them.
POSTGRES_DB=sync
POSTGRES_USER=sync
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://sync:choose-a-local-password@127.0.0.1:5432/sync

# --- Payments -------------------------------------------------------------
# Which gateway takes money from customers. The default moves nothing and
# reports every payment as pending, which is what you want locally: the whole
# payment flow works without a Paystack account, and nothing succeeds by
# accident.
#
#   apps.payments.gateways.fake.FakeGateway          local and test default
#   apps.payments.gateways.paystack.PaystackGateway  production
PAYMENT_GATEWAY=apps.payments.gateways.fake.FakeGateway

# Signs webhooks for the fake gateway so signature checking, replay and forgery
# refusal are all exercised locally. Not a production credential: with Paystack
# configured this is never read. Any string will do.
PAYMENT_GATEWAY_FAKE_SECRET=fake-gateway-signing-secret

# Paystack, from the dashboard at https://dashboard.paystack.com/#/settings/developers
# Required in production when PAYMENT_GATEWAY is the Paystack adapter. Leave
# both blank locally.
#
# The secret key signs API requests and verifies webhook signatures. It must
# never reach a client, appear in a log, or be committed. The public key is safe
# in a client and is here so one place describes the account.
#
# Set the webhook URL in the same dashboard to:
#   https://your-domain/api/v1/webhooks/paystack/
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Confirms a provider's bank account is real before money is sent to it.
# Paystack resolves account numbers, so the same credentials serve both.
#
#   apps.payments.banks.fake.FakeBankResolver          local and test default
#   apps.payments.banks.paystack.PaystackBankResolver  production
BANK_RESOLVER=apps.payments.banks.fake.FakeBankResolver

# --- SMS ------------------------------------------------------------------
# Phone verification sends codes through this provider. The default prints the
# code to the console and sends nothing, which is what you want locally.
#
#   apps.accounts.sms.console.ConsoleSMSProvider   local default
#   apps.accounts.sms.termii.TermiiSMSProvider     production
SMS_BACKEND=apps.accounts.sms.console.ConsoleSMSProvider

# Termii, from https://accounts.termii.com. Required in production when
# SMS_BACKEND is the Termii adapter. TERMII_SENDER_ID must be a sender Termii
# has approved for the account: an unapproved one is the usual reason messages
# are accepted and never delivered.
TERMII_API_KEY=
TERMII_SENDER_ID=Sync
TERMII_CHANNEL=dnd

# --- Email ----------------------------------------------------------------
# Django's own email framework is the abstraction, and this setting selects the
# implementation. The default prints to the console and sends nothing.
#
#   django.core.mail.backends.console.EmailBackend   local default
#   apps.accounts.email.resend.ResendEmailBackend    production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sync <no-reply@sync.ng>

# Resend, from https://resend.com/api-keys. Required in production when
# EMAIL_BACKEND is the Resend backend. The sending domain must be verified at
# Resend first, and DEFAULT_FROM_EMAIL must be an address on it.
RESEND_API_KEY=

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
