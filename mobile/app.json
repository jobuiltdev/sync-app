{
  "expo": {
    "name": "Sync",
    "slug": "sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.sync.app",
      "icon": {
        "light": "./assets/images/ios-icon-light.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "ng.sync.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F3",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 86,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#14110E",
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 86,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sync uses your location only while you are looking at a job, to show how far away it is. It is never shared and never leaves your phone.",
          "locationWhenInUsePermission": "Sync uses your location only while you are looking at a job, to show how far away it is. It is never shared and never leaves your phone.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
